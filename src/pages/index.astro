  .fc-card--red { background: linear-gradient(135deg, #c8201c 0%, #8a1612 100%); }
  .fc-card--orange { background: linear-gradient(135deg, #e07020 0%, #b04810 100%); }
  .fc-card--purple { background: linear-gradient(135deg, #7a4090 0%, #4e2868 100%); }
  .fc-card--blue { background: linear-gradient(135deg, #2a4d8c 0%, #1a3568 100%); }

  /* === HERO === 暖色系（kissfx風：黄×白×赤アクセント・親しみやすい） */
