---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PREF_SLUG_MAP } from "../lib/prefecture-slug";

// approved/*.json からローカル集計（記事数・累計損失額・分布）
type Entry = {
  slug: string;
  title: string;
  category: string;
  catKey: string;
  scheme: string;
  loss: number;
  age?: number | string;
  gender?: string;
  occupation?: string;
  prefecture?: string;
};
let stockCount = 0;
let totalLossYen = 0;
const entries: Entry[] = [];
const CAT_LABEL: Record<string, string> = {
  joho: "情報商材",
  mlm: "MLM",
  coach: "コンサル詐欺",
  ai: "AI副業",
  invest: "投資型副業",
  romance: "ロマンス商法",
  busshu: "物販系",
  overseas: "海外案件",
};
try {
  const dir = path.join(process.cwd(), "approved");
  if (fs.existsSync(dir)) {
    const files = fs.readdirSync(dir).filter((f) => f.endsWith(".json"));
    for (const f of files) {
      try {
        const j = JSON.parse(fs.readFileSync(path.join(dir, f), "utf-8"));
        if (typeof j.loss_amount_yen === "number") {
          stockCount++;
          totalLossYen += j.loss_amount_yen;
          entries.push({
            slug: j.slug,
            title: j.title,
            catKey: j.category,
            category: CAT_LABEL[j.category] ?? j.category ?? "",
            scheme: j.scheme ?? "",
            loss: j.loss_amount_yen,
            age: j.persona?.age ?? "",
            gender: j.persona?.gender ?? "",
            occupation: (j.persona?.occupation ?? "").split("（")[0],
            prefecture: j.persona?.prefecture ?? "",
          });
        }
      } catch {}
    }
  }
} catch {}

// 表示フォーマット統一：¥1,000,000- 形式
const formatLoss = (yen: number): string => `¥${yen.toLocaleString()}-`;
const totalLossLabel = stockCount > 0 ? formatLoss(totalLossYen) : "順次更新";

// LATEST CASES（カテゴリ分散3枚）：slug の数字が大きいものを優先
const sortedBySlug = [...entries].sort((a, b) => b.slug.localeCompare(a.slug));
const latestSamples: Entry[] = [];
const seenCats = new Set<string>();
for (const e of sortedBySlug) {
  if (latestSamples.length >= 3) break;
  if (seenCats.has(e.catKey)) continue;
  seenCats.add(e.catKey);
  latestSamples.push(e);
}

// LOSS RANKING（損失額ランキング Top 10）
const lossRanking = [...entries].sort((a, b) => b.loss - a.loss).slice(0, 10);

// VOICES（被害者の声）：実記事と紐付け、クリックで該当記事に遷移
const voiceLines = [
  { slug: "fukugyo-joho-002", q: "「コピペで稼げる」を信じて、バイト代と親借金で45万円", who: "情報商材 / 22歳大学生 / 札幌" },
  { slug: "fukugyo-ai-001", q: "AIが自動で稼ぐ、と言われた。提供物はChatGPT APIのラッパー", who: "AI副業 / 43歳男性 / 大阪" },
  { slug: "fukugyo-mlm-001", q: "『ママ友に勧められるかも』と思った瞬間が、一線を越えた瞬間でした", who: "健康食品MLM / 34歳女性 / 東京" },
  { slug: "fukugyo-romance-001", q: "シンガポール起業家を名乗る相手に、半年で250万円", who: "ロマンス商法 / 43歳女性 / 兵庫" },
  { slug: "fukugyo-coach-003", q: "コーチング3か月45万→延長で100万、コーチが突然消えた", who: "高額コーチング / 36歳女性 / 徳島" },
  { slug: "fukugyo-busshu-001", q: "前職アパレル経験を活かせると思った物販スクール120万", who: "物販系 / 31歳女性 / 東京" },
];

// 都道府県集計
const prefSet = new Set(entries.map((e) => e.prefecture).filter(Boolean) as string[]);
const prefList = Array.from(prefSet).sort();

// カテゴリ別件数
const catCountMap: Record<string, number> = {};
for (const e of entries) {
  catCountMap[e.catKey] = (catCountMap[e.catKey] || 0) + 1;
}

// 年代別件数
const ageGroups: { label: string; count: number; min: number; max: number }[] = [
  { label: "20代", count: 0, min: 20, max: 29 },
  { label: "30代", count: 0, min: 30, max: 39 },
  { label: "40代", count: 0, min: 40, max: 49 },
  { label: "50代", count: 0, min: 50, max: 59 },
  { label: "60代以上", count: 0, min: 60, max: 99 },
];
for (const e of entries) {
  const a = typeof e.age === "number" ? e.age : parseInt(String(e.age), 10);
  if (Number.isNaN(a)) continue;
  for (const g of ageGroups) {
    if (a >= g.min && a <= g.max) { g.count++; break; }
  }
}
const maxAgeCount = Math.max(...ageGroups.map((g) => g.count), 1);

// 損失額レンジ別件数
const lossRanges: { label: string; count: number; min: number; max: number; sumYen: number }[] = [
  { label: "～30万", count: 0, min: 0, max: 300000, sumYen: 0 },
  { label: "30～80万", count: 0, min: 300000, max: 800000, sumYen: 0 },
  { label: "80～150万", count: 0, min: 800000, max: 1500000, sumYen: 0 },
  { label: "150～300万", count: 0, min: 1500000, max: 3000000, sumYen: 0 },
  { label: "300万以上", count: 0, min: 3000000, max: Infinity, sumYen: 0 },
];
for (const e of entries) {
  for (const r of lossRanges) {
    if (e.loss >= r.min && e.loss < r.max) { r.count++; r.sumYen += e.loss; break; }
  }
}
const maxLossCount = Math.max(...lossRanges.map((r) => r.count), 1);

// 編集ノート
const editorNotes = [
  {
    date: "2026.05.12",
    title: "LINEで届く『稼げる』の正体",
    excerpt:
      "コピーライティング情報商材45万、AI自動収益ツール60万…構造はほぼ同じ。「初月から黒字」「あと3名限定」というキーワードを見たら、即時連絡を絶ってください。",
    cat: "情報商材",
  },
  {
    date: "2026.05.10",
    title: "高額コーチング、見分け方は3つ",
    excerpt:
      "①成果指標（KPI）が定義されてるか ②契約解除条件・返金規定が明文化されてるか ③コーチ自身の過去の生徒事例が公開されてるか。3つとも揃わない時点で、契約は見送り。",
    cat: "コンサル詐欺",
  },
  {
    date: "2026.05.08",
    title: "なぜMLMで友達を失うのか",
    excerpt:
      "暗号資産MLMで友人3人を巻き込んだIさんの話。被害額350万円より重いのは、人間関係の崩壊。MLMは構造的に被害者が加害者にもなる二重ダメージ構造。",
    cat: "MLM",
  },
  {
    date: "2026.05.06",
    title: "AI副業、急増する2つの罠",
    excerpt:
      "①汎用AI（ChatGPT等）の単純なラッパーを「独自AI」と称する商材 ②AI生成コンテンツのストック販売（規約変更で一夜にBAN）。AIブームに乗じた典型パターン。",
    cat: "AI副業",
  },
  {
    date: "2026.05.03",
    title: "ロマンス商法、3つの典型",
    excerpt:
      "①マッチング起点 ②海外在住設定 ③通話・ビデオ通話回避。この3点セットは2024-2025年急増のテンプレート。Google画像検索でプロフィール写真の使い回しを確認するのが第一防衛。",
    cat: "ロマンス商法",
  },
  {
    date: "2026.04.30",
    title: "退職金が狙われる年代",
    excerpt:
      "60代・退職前後の被害が増加。不動産小口投資・株式コンサル・国際ロマンス詐欺は、退職金1000-2000万円規模を狙う設計。退職金は「増やそう」と思った瞬間、リスクに晒される。",
    cat: "投資型副業",
  },
];
---

<BaseLayout
  title="副業詐欺録 ─ 騙された話を、騙される前に。"
  description="情報商材・MLM・AI副業・コンサル詐欺・ロマンス商法など、副業を装った詐欺の実例を読者投稿の取材記録としてアーカイブしています。被害に遭う前に手口を知る場所。"
>

<section class="hero">
  <div class="hero__inner">
    <span class="hero__sub-en">FUKUGYOU SAGI ROKU ・ FRAUD RECORDS</span>
    <h1 class="hero__title">
      騙された話を、<br/>
      <span class="hero__title__accent">騙される前に。</span>
    </h1>
    <p class="hero__lead">
      情報商材・MLM・AI副業・コンサル詐欺・ロマンス商法。<br/>
      『楽に稼げる』の裏側で起きていた話を、読者投稿の取材記録としてアーカイブしています。
    </p>
    <p class="hero__editor-note">― 怪しい話は、聞いてからじゃ遅い。―</p>

    <div class="hero-cta">
      <a href="/guide/sidejob-fraud-master/" class="hero-cta__primary hero-cta__primary--pillar">副業詐欺の見抜き方 完全版 →</a>
      <a href="#section-latest" class="hero-cta__secondary">手口を読む</a>
      <a href="#section-ranking" class="hero-cta__secondary">損失額ランキング</a>
      <a href="/about/" class="hero-cta__secondary">運営方針</a>
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <span class="hero__stat__label">CASES</span>
        <span class="hero__stat__num">{stockCount}<span class="hero__stat__suffix">件</span></span>
        <span class="hero__stat__sub">取材済の手口記録</span>
      </div>
      <div class="hero__stat hero__stat--main">
        <span class="hero__stat__label">TOTAL LOSS</span>
        <span class="hero__stat__num">{totalLossLabel}</span>
        <span class="hero__stat__sub">累計被害額（集計値）</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat__label">CATEGORIES</span>
        <span class="hero__stat__num hero__stat__num--text">{new Set(entries.map(e => e.catKey)).size}<span class="hero__stat__suffix">分類</span></span>
        <span class="hero__stat__sub">情商・MLM・AI副業ほか</span>
      </div>
    </div>
  </div>
</section>

<div class="disclaimer">
  <span class="disclaimer__icon"></span>
  <strong>注意</strong>：本記事は実例の警告アーカイブです。特定の業者・個人を名指しで攻撃する目的ではありません。被害申告は
  <a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">消費生活センター（188）</a>・警察相談（#9110）へ。
</div>

<main class="container">

<!-- FEATURED CARDS（kissfx風カラフル大型カード） -->
<section class="featured-cards">
  <a href="/guide/sidejob-fraud-master/" class="fc-card fc-card--red">
    <span class="fc-card__cat">完全ガイド</span>
    <h3 class="fc-card__title">副業詐欺の<br>見抜き方</h3>
    <p class="fc-card__desc">9パターン×判断軸5つ。本人取材で見えた手口の全体像。</p>
    <span class="fc-card__cta">読む →</span>
  </a>
  <a href="#section-ranking" class="fc-card fc-card--orange">
    <span class="fc-card__cat">損失額TOP</span>
    <h3 class="fc-card__title">被害額<br>ランキング</h3>
    <p class="fc-card__desc">取材記録から損失額順に並べた手口別の被害規模。</p>
    <span class="fc-card__cta">見る →</span>
  </a>
  <a href="https://toushishippairoku.com/category/jiken/" target="_blank" rel="noopener" class="fc-card fc-card--purple">
    <span class="fc-card__cat">過去事案</span>
    <h3 class="fc-card__title">有名事案<br>アーカイブ</h3>
    <p class="fc-card__desc">ジャパンライフ・安愚楽牧場・L&G・テキシア等の構造解説。</p>
    <span class="fc-card__cta">学ぶ →</span>
  </a>
  <a href="#section-checklist" class="fc-card fc-card--blue">
    <span class="fc-card__cat">警戒サイン</span>
    <h3 class="fc-card__title">チェック<br>リスト</h3>
    <p class="fc-card__desc">即時連絡を絶つべき8つの危険サイン。3つ以上で要警戒。</p>
    <span class="fc-card__cta">確認 →</span>
  </a>
</section>

<!-- LATEST CASES -->
<header class="section-h" id="section-latest">
  <div class="section-h__title-group">
    <span class="section-h__sub">LATEST CASES</span>
    <h2 class="section-h__title">最近の手口</h2>
  </div>
  <a href="/articles/" class="section-h__more">すべての記録 →</a>
</header>
{latestSamples.length === 0 ? (
  <p class="empty-state">手口の記録は順次掲載予定です。取材が完了したものから随時掲載します。</p>
) : (
  <div class="case-grid">
    {latestSamples.map((e) => (
      <a href={`/articles/${e.slug}/`} class="case-card">
        <div class="case-card__thumb">
          <img src={`/ogp/${e.slug}.png`} alt={e.title} loading="lazy" width="600" height="315" />
        </div>
        <div class="case-card__body">
          <span class="case-card__cat">{e.category}</span>
          <h3 class="case-card__title">{e.title}</h3>
          <div class="case-card__meta">
            <span class="case-card__loss">{formatLoss(e.loss)}</span>
            <span class="case-card__who">{e.age}歳{e.gender} / {e.prefecture}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
)}

<!-- VOICES -->
<header class="section-h" id="section-voices">
  <div class="section-h__title-group">
    <span class="section-h__sub">VOICES</span>
    <h2 class="section-h__title">取材で届いた声</h2>
  </div>
</header>
<div class="voices-grid">
  {voiceLines.map((v) => (
    <a href={`/articles/${v.slug}/`} class="voice-card">
      <p class="voice-card__quote">「{v.q}」</p>
      <p class="voice-card__who">― {v.who}</p>
      <span class="voice-card__more">記事を読む →</span>
    </a>
  ))}
</div>

<!-- DASHBOARD: 被害傾向 -->
<header class="section-h" id="section-dash">
  <div class="section-h__title-group">
    <span class="section-h__sub">DASHBOARD</span>
    <h2 class="section-h__title">被害傾向ダッシュボード</h2>
  </div>
  <span class="section-h__more">取材記録 {stockCount} 件の集計</span>
</header>
<div class="dash-grid">
  <div class="dash-card">
    <h3 class="dash-card__title">年代別 被害分布</h3>
    <ul class="dash-bar">
      {ageGroups.map((g) => (
        <li class="dash-bar__row">
          <span class="dash-bar__label">{g.label}</span>
          <div class="dash-bar__track">
            <span class="dash-bar__fill" style={`width: ${(g.count / maxAgeCount) * 100}%`}></span>
          </div>
          <span class="dash-bar__val">{g.count}件</span>
        </li>
      ))}
    </ul>
    <p class="dash-card__note">30代が最も多く、副業を始める年代と詐欺リスクの相関が見える。60代は退職金狙いの大型案件が含まれる。</p>
  </div>

  <div class="dash-card">
    <h3 class="dash-card__title">損失額レンジ別 件数</h3>
    <ul class="dash-bar">
      {lossRanges.map((r) => (
        <li class="dash-bar__row">
          <span class="dash-bar__label">{r.label}</span>
          <div class="dash-bar__track">
            <span class="dash-bar__fill dash-bar__fill--loss" style={`width: ${(r.count / maxLossCount) * 100}%`}></span>
          </div>
          <span class="dash-bar__val">{r.count}件</span>
        </li>
      ))}
    </ul>
    <p class="dash-card__note">80～150万円ゾーンに集中。住宅ローン控除分やボーナス・退職金のサブセットが標的になりやすい金額帯。</p>
  </div>
</div>

<!-- RANKINGS - 3つのボタン横並び -->
<header class="section-h" id="section-ranking">
  <div class="section-h__title-group">
    <span class="section-h__sub">RANKINGS</span>
    <h2 class="section-h__title">3つのランキング</h2>
  </div>
  <span class="section-h__more">集計値：{totalLossLabel}</span>
</header>
<div class="rank-cards">
  <a href="/ranking/loss/" class="rank-card">
    <span class="rank-card__num">01</span>
    <span class="rank-card__title">損失額 TOP10</span>
    <span class="rank-card__sub">いちばん持っていかれた人たち</span>
    <span class="rank-card__cta">ランキングを見る →</span>
  </a>
  <a href="/ranking/phrase/" class="rank-card">
    <span class="rank-card__num">02</span>
    <span class="rank-card__title">信じやすい謳い文句 TOP10</span>
    <span class="rank-card__sub">「絶対稼げる」が何回出てきたかの集計</span>
    <span class="rank-card__cta">ランキングを見る →</span>
  </a>
  <a href="/ranking/young/" class="rank-card">
    <span class="rank-card__num">03</span>
    <span class="rank-card__title">最年少被害者 TOP10</span>
    <span class="rank-card__sub">19歳から記録、若さは標的にされやすい</span>
    <span class="rank-card__cta">ランキングを見る →</span>
  </a>
</div>

<!-- CATEGORIES -->
<header class="section-h" id="section-cats">
  <div class="section-h__title-group">
    <span class="section-h__sub">CATEGORIES</span>
    <h2 class="section-h__title">手口の分類</h2>
  </div>
</header>
<div class="cat-grid">
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">情報商材</span><span class="cat-card__cnt">{catCountMap.joho ?? 0}件</span></div>
    <span class="cat-card__desc">「絶対勝てる」「コピペで月100万」型の高額教材。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">MLM</span><span class="cat-card__cnt">{catCountMap.mlm ?? 0}件</span></div>
    <span class="cat-card__desc">健康食品・化粧品・暗号資産の連鎖紹介ビジネス。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">コンサル詐欺</span><span class="cat-card__cnt">{catCountMap.coach ?? 0}件</span></div>
    <span class="cat-card__desc">高額コーチング・コンサル・スクール商法。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">AI副業</span><span class="cat-card__cnt">{catCountMap.ai ?? 0}件</span></div>
    <span class="cat-card__desc">「AIで自動収益」を謳う2024-2025年急増型。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">投資型副業</span><span class="cat-card__cnt">{catCountMap.invest ?? 0}件</span></div>
    <span class="cat-card__desc">「副業として投資」を装い金商法を回避するもの。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">ロマンス商法</span><span class="cat-card__cnt">{catCountMap.romance ?? 0}件</span></div>
    <span class="cat-card__desc">マッチング・SNS経由の心理操作型投資勧誘。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">物販系</span><span class="cat-card__cnt">{catCountMap.busshu ?? 0}件</span></div>
    <span class="cat-card__desc">Amazon物販・転売スクール・在庫買取型。</span>
  </div>
  <div class="cat-card">
    <div class="cat-card__head"><span class="cat-card__name">海外案件</span><span class="cat-card__cnt">{catCountMap.overseas ?? 0}件</span></div>
    <span class="cat-card__desc">海外送金型・ペーパーファンド・越境EC。</span>
  </div>
</div>

<!-- 全国分布 -->
<header class="section-h" id="section-map">
  <div class="section-h__title-group">
    <span class="section-h__sub">NATIONWIDE</span>
    <h2 class="section-h__title">被害発生エリア</h2>
  </div>
  <span class="section-h__more">{prefList.length} 都道府県から取材記録</span>
</header>
<div class="map-list">
  {prefList.map((p) => {
    const slug = PREF_SLUG_MAP[p];
    return slug
      ? <a class="map-tag map-tag--link" href={`/prefecture/${slug}/`}>{p}</a>
      : <span class="map-tag">{p}</span>;
  })}
</div>

<!-- CHECKLIST -->
<header class="section-h" id="section-checklist">
  <div class="section-h__title-group">
    <span class="section-h__sub">CHECKLIST</span>
