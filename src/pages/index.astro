  .empty-state { padding: 60px 20px; text-align: center; color: var(--color-text-muted); font-size: 0.9rem; border: 1px dashed var(--color-border); border-radius: 4px; }

  /* === CASE CARDS === */
  .case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .case-card {
    display: block; padding: 0 0 18px;
    background: var(--color-bg-card);
