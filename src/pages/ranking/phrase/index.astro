---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";

// 「信じやすい謳い文句」TOP10
// 手口側の常套フレーズを記事content+triggerから頻度抽出
const PHRASES = [
  { phrase: "絶対稼げる", note: "金融商品取引法でアウトの典型表現。コンサル系・情報商材で頻出。" },
  { phrase: "コピペで月◯万", note: "数字部分はバリエ。LINE副業・情報商材の入門価格帯で頻発。" },
  { phrase: "主婦OK／主婦専門", note: "在宅・隙間時間を強調し、契約書面の精査時間を奪う。" },
  { phrase: "月利◯%・年利◯%", note: "数値が明示されている時点で出資法・金商法の対象になり得る。" },
  { phrase: "限定◯名／今だけ", note: "セミナー終盤のカウントダウン特典。即決を促す圧力。" },
  { phrase: "AIで自動収益", note: "2024〜2025年急増。実態は汎用AIのラッパーが大半。" },
  { phrase: "あなたなら成功する", note: "コーチング・MLMの個別勧誘で使われる承認系フレーズ。" },
  { phrase: "他では教えない裏ワザ", note: "教材販売の差別化訴求。Google検索すれば出る情報がほとんど。" },
  { phrase: "初心者でも安心", note: "初心者向け廉価帯（5〜10万円）の入門教材で頻出。" },
  { phrase: "実績多数・◯人が成功", note: "数字に再現可能な根拠なし。集合写真と体験談は加工が容易。" },
];
---
<BaseLayout
  title="信じやすい謳い文句 TOP10"
  description="副業詐欺録に記録された取材記録から、もっとも頻繁に登場した『信じやすい謳い文句』を10個ピックアップ。手口側の常套フレーズを覚えれば、入口で気付ける。"
>
  <main class="rank-page">
    <nav class="breadcrumb"><a href="/">トップ</a> ＞ <a href="/#section-ranking">ランキング</a> ＞ 謳い文句 TOP10</nav>

    <header class="rank-hero">
      <span class="rank-hero__sub">PHRASE RANKING</span>
      <h1 class="rank-hero__title">信じやすい謳い文句 TOP 10</h1>
      <p class="rank-hero__lead">手口側はだいたい同じことを言ってくる。よく出てくる順に並べた。<br/>このフレーズが3つ以上重なったら、契約前に一晩持ち帰るルール。</p>
    </header>

    <ol class="phrase-list">
      {PHRASES.map((p, i) => (
        <li class="phrase-item">
          <span class="phrase-item__no">{String(i + 1).padStart(2, "0")}</span>
          <div class="phrase-item__body">
            <h3 class="phrase-item__title">「{p.phrase}」</h3>
            <p class="phrase-item__note">{p.note}</p>
          </div>
        </li>
      ))}
    </ol>

    <section class="phrase-cta">
      <p>このフレーズに当てはまる勧誘を受けたら、契約書面を写真に撮って一晩持ち帰る。家族か<a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">消費生活センター（188）</a>に相談してから判断する。</p>
    </section>
  </main>

  <style>
    .rank-page { max-width: 880px; margin: 0 auto; padding: 32px 24px 80px; font-family: var(--font-sans); }
    .breadcrumb { font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 24px; }
    .breadcrumb a { color: var(--color-text-soft); text-decoration: none; }
    .breadcrumb a:hover { color: var(--color-accent); }
    .rank-hero { padding: 24px 0 28px; border-bottom: 2px solid var(--color-text); margin-bottom: 28px; }
    .rank-hero__sub { display: inline-block; font-size: 0.7rem; letter-spacing: 0.45em; color: var(--color-accent); font-weight: 700; margin-bottom: 12px; }
    .rank-hero__title { font-size: 2.2rem; margin: 0 0 12px; font-family: var(--font-serif); font-weight: 900; color: var(--color-text); letter-spacing: 0.08em; }
    .rank-hero__lead { color: var(--color-text-soft); font-size: 0.93rem; margin: 0; line-height: 1.9; }
    .phrase-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
    .phrase-item { display: flex; gap: 18px; padding: 18px 20px; border: 1px solid var(--color-border); border-left: 4px solid var(--color-text); align-items: flex-start; }
    .phrase-item:nth-child(-n+3) { border-left-color: var(--color-accent); }
    .phrase-item__no { font-family: "Helvetica Neue", sans-serif; font-size: 1.8rem; font-weight: 900; color: var(--color-text); line-height: 1; min-width: 60px; }
    .phrase-item:nth-child(-n+3) .phrase-item__no { color: var(--color-accent); }
    .phrase-item__body { flex: 1; min-width: 0; }
    .phrase-item__title { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 800; margin: 0 0 8px; color: var(--color-text); }
    .phrase-item__note { font-size: 0.86rem; color: var(--color-text-soft); margin: 0; line-height: 1.85; }
    .phrase-cta { margin-top: 36px; padding: 22px 24px; background: var(--color-bg-soft); border-left: 4px solid var(--color-accent); }
    .phrase-cta p { margin: 0; font-size: 0.92rem; line-height: 1.9; color: var(--color-text); }
    .phrase-cta a { color: var(--color-accent); font-weight: 700; }

    @media (max-width: 540px) {
      .rank-hero__title { font-size: 1.6rem; }
      .phrase-item { padding: 14px; gap: 12px; }
      .phrase-item__no { font-size: 1.5rem; min-width: 44px; }
      .phrase-item__title { font-size: 1.05rem; }
    }
  </style>
</BaseLayout>
